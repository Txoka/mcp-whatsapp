COMPOSE_PROJECT_NAME=mcp-whatsapp
WHATSAPP_IMAGE=mcp-whatsapp:local
WHATSAPP_UPLOADS_PATH=/absolute/path/to/mcp-whatsapp/deployment/store/uploads
LOCAL_UID=1000
LOCAL_GID=1000
MCP_VERSION=dev

# Operator resource/compatibility settings, not WhatsApp quotas or agent inputs.
WHATSAPP_HISTORY_CONCURRENCY=1
WHATSAPP_HISTORY_QUEUE=64
WHATSAPP_HISTORY_BATCH_SIZE=50
WHATSAPP_READ_TIMEOUT=5m
WHATSAPP_MAX_PAGE_SIZE=100
WHATSAPP_MAX_RESPONSE_BYTES=262144

# IANA display timezone. Storage remains UTC; DST is automatic.
WHATSAPP_TIMEZONE=Europe/Madrid

# Maximum sync window for recent-message reads before cache fallback.
WHATSAPP_RECENT_SYNC_TIMEOUT=3s
